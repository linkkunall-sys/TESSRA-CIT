# ---- Database (required) -----------------------------------------------
# Any PostgreSQL connection string. The live CIT deployment uses Neon.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- Optional Supabase Auth -------------------------------------------
# Leave these blank to use the built-in database-backed authentication layer.
# If intentionally enabled, get the values from Supabase Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, NEVER expose to the browser

# When configured, the app uses Supabase Auth (email+password) instead of
# custom session cookies. When left blank, the app falls back to its built-in
# session-cookie auth layer (works without Supabase).

# ---- Scheduling engine --------------------------------------------------
# Leave ENGINE_URL empty to run engine/solve.py as a local subprocess (needs
# python3 + ortools: `pip install ortools`). In production, point it to the
# FastAPI service in engine/app.py; Vercel Services can inject this binding.
ENGINE_URL=
ENGINE_TOKEN=
# Comma-separated origins allowed to call the engine service
ENGINE_ALLOWED_ORIGINS=http://localhost:3000
PYTHON_BIN=python3

# ---- Optional LLM intent provider (deterministic fallback always works) --
# Supported: openai, openai-compatible, anthropic
AI_PROVIDER=
AI_API_KEY=                  # server-only; never commit a real key
AI_MODEL=
AI_BASE_URL=                 # optional; OpenAI-compatible endpoint, defaults to https://api.openai.com/v1
